# Hidden local state and editor files
.*
!.github/
!.github/**
!.githooks/
!.githooks/**
!.gitignore
!.python-version
# re-ignore after the .github/.githooks exceptions above, which would otherwise
# un-ignore Finder metadata inside those directories
.DS_Store
*.swp

# Caches, reports, and build artifacts
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# Models, checkpoints, tokenizers, and conversion artifacts — never commit
weights/
models/
checkpoints/
model_cache/
tokenizer_cache/
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.gguf
*.bin
*.npz
*.npy

# Private prompts, cases, inputs, and generated artifacts — never commit
prompts/
cases/
examples/
samples/
inputs/
outputs/
artifacts/
runs/
logs/
*.prompt
*.prompt.*
*.case
*.case.*
*.log

# Generated media — never commit
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav
*.flac
*.mp3
*.aac
*.m4a
*.png
*.jpg
*.jpeg
*.webp
*.gif
